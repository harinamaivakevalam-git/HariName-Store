# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5000

# JWT Authentication
JWT_SECRET=harinama_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Supabase Credentials (Optional for local hybrid mode, required for live Supabase PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payment Gateways (Live or Sandbox)
# Razorpay (India)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# Stripe (Global)
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_SECRET_KEY=sk_test_placeholder_secret
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# Google Maps Platform (Geocoding & Places API)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Shiprocket Logistics Configuration
SHIPROCKET_EMAIL=your_shiprocket_api_user_email
SHIPROCKET_PASSWORD=your_shiprocket_api_user_password
SHIPROCKET_PICKUP_PINCODE=281121
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_COURIER_SELECTION_MODE=cheapest

# Default Packaging & Physical Dimensions for Calculation
DEFAULT_PACKAGING_WEIGHT_GRAMS=47
DEFAULT_PACKAGE_LENGTH_CM=15
DEFAULT_PACKAGE_BREADTH_CM=10
DEFAULT_PACKAGE_HEIGHT_CM=3

# SMTP Email Dispatch (Gmail or Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_gmail_app_password
SMTP_FROM_NAME="HariNama Store"
SMTP_FROM_EMAIL=your_email@gmail.com
